# TimeLight Map options. To use: copy this file into the mod's folder as timelight-map.cfg and edit it.
# Read once when the game starts. A key you leave out keeps the value shown here.
# The same words work in the game's console while you play: topcam <key> <value>, e.g. topcam corner bottom-left
map = on              # on | off
corner = top-right    # top-left | top-right | bottom-left | bottom-right
size = medium         # small | medium | large | the map's height as a percent of the window's (10..60)
margin = 24           # pixels from the window's edges (0..400)
follow = squad        # squad (your people) | camera (where you look) | off (stays put)
zoom = 150            # metres across the map (10..5000)
pitch = 90            # 90 looks straight down; lower, down to 35: tilted, heights show
alpha = 1             # the map's strength: 1 solid, 0.5 half see-through (0..1)
marks = on            # dots, names, labels, scale bar, north arrow
cone = on             # the dotted cone showing where the main camera looks
places = on           # names of the towns and places you have discovered
