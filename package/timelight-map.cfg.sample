# TimeLight Map options. To use: copy this file into the mod's folder as timelight-map.cfg and edit it.
# Read once when the game starts. A key you leave out keeps the value shown here.
# What you change on the game's Settings > Mods page (TimeLight Map) is kept by the game and wins over this file.
# The same words work in the game's console while you play: topcam <key> <value>, e.g. topcam corner bottom-left
corner = top-right      # top-left | top-right | bottom-left | bottom-right | free (free: at 'rect')
size = medium           # small | medium | large | the map's height as a percent of the window's (10..60)
margin = 24             # pixels from the window's edges (0..400)
rect = 24 24 480 336    # x y w h in window pixels, used only with corner = free
shape = square          # square | round
frame = off             # on: a thin frame round the map
follow = squad          # squad (your active squad) | selected (the people you selected) | camera (where you look) | off (stays put)
zoom = 150              # metres across the map (10..5000; widest zoom when autozoom is on)
minzoom = 50            # closest metres across when your group is huddled together (with autozoom on; 10..5000)
autozoom = on           # on: zooms in closer when your followed group is close together, out as they spread
pitch = 90              # 90 looks straight down; lower, down to 35: tilted, heights show
yaw = 0                 # the map's turn: 0 north up, 90 east up (0..360)
alpha = 1               # the map's strength: 1 solid, 0.5 half see-through (0..1)
quality = high          # low | medium | high: how sharp and how often the picture is drawn (low and medium are faster)
marks = on              # everything drawn on the picture (all the marks below)
names = on              # your people's names
hostiles = on           # red dots on characters hostile to you
foelabels = auto        # auto (labels enemies attacking your squad) | on (all visible hostiles) | off (dots only)
traders = on            # green markers on moving trade caravans
places = on             # names of the towns and places you have discovered
cone = on               # the dotted cone showing where the main camera looks
arrows = on             # small arrows on your people while they walk
routes = on             # where your selected people are walking to (their path and its end)
hurt = on               # an orange or red ring on anyone badly hurt
scale = on              # the scale bar
north = on              # the north arrow
squadbars = off         # on: docked Squad HP and Squad Fed bars beside the map
clock = off             # on: in-game day and clock time above the scale bar
cats = off              # on: your Cats (money) above the scale bar
speed = off             # on: game speed / paused indicator below the scale bar
textscale = 1           # the size of the names and labels (0.5..3)
hidewithui = on         # on: the map hides while the game's interface is hidden (F7, hud hide); off: it stays
keys = on               # the map's hotkeys below (a key you bind in the game's own settings wins over them)
key_toggle = N          # shows / hides the map
key_big = Shift+N       # the big map in the middle of the screen, and back
key_zoomin = Equal      # zoom in (Equal is the = key)
key_zoomout = Minus     # zoom out
map = on                # on | off: the map itself
